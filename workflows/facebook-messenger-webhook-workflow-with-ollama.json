    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"llama3.1:8b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"তুমি একজন সহায়ক ইউনানী স্বাস্থ্য-তথ্য সহকারী। তুমি প্রকৃত হাকিম/ডাক্তারের বিকল্প নও, শুধু সাধারণ তথ্য দাও এবং জটিল/গুরুতর ক্ষেত্রে সবসময় একজন প্রকৃত হাকিম দেখানোর পরামর্শ দাও।\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": $json.user_input\n    }\n  ],\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.7,\n    \"max_tokens\": 500\n  }\n} }}",
        "options": {}
      },
      "id": "ollama-text-node",
      "name": "Call Ollama (Text)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"llama3.1:8b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"তুমি একজন সহায়ক ইউনানী স্বাস্থ্য-তথ্য সহকারী। তুমি প্রকৃত হাকিম/ডাক্তারের বিকল্প নও, শুধু সাধারণ তথ্য দাও এবং জটিল/গুরুতর ক্ষেত্রে সবসময় একজন প্রকৃত হাকিম দেখানোর পরামর্শ দাও।\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": $json.user_input\n    }\n  ],\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.7,\n    \"max_tokens\": 500\n  }\n} }}",
        "options": {}

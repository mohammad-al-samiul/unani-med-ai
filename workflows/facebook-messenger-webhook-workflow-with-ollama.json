    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "extract-sender-id",
              "name": "sender_id",
              "value": "={{ $json.entry[0].messaging[0].sender.id }}",
              "type": "string"
            },
            {
              "id": "extract-recipient-id",
              "name": "recipient_id",
              "value": "={{ $json.entry[0].messaging[0].recipient.id }}",
              "type": "string"
            },
            {
              "id": "extract-message-type",
              "name": "message_type",
              "value": "={{ $json.entry[0].messaging[0].message ? ($json.entry[0].messaging[0].message.attachments && $json.entry[0].messaging[0].message.attachments.length > 0 ? 'voice' : 'text') : 'unknown' }}",
              "type": "string"
            },
            {
              "id": "extract-content",
              "name": "content",
              "value": "={{ $json.entry[0].messaging[0].message ? ($json.entry[0].messaging[0].message.text || $json.entry[0].messaging[0].message.attachments[0].payload.url) : null }}",
              "type": "string"
            },
            {
              "id": "extract-timestamp",
              "name": "timestamp",
              "value": "={{ $json.entry[0].messaging[0].timestamp }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-data-node",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 500]

FB_VERIFY_TOKEN=unani_verify_token_2026
FB_APP_ID=
FB_APP_SECRET=

# Telegram Bot Integration (for customer lead & order notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database Paths
LEADS_DB_PATH=data/databases/customer_leads.db
ANALYTICS_DB_PATH=data/databases/analytics.db
FEEDBACK_DB_PATH=data/databases/feedback.db
PATIENT_PROFILE_DB_PATH=data/databases/patient_profiles.db

# Other Paths

# UnaniMed AI Environment Variables (Example)

# Server Ports
UNIFIED_PORT=8010
STT_PORT=8001
TTS_PORT=8002
PATIENT_PROFILE_PORT=8003
SAFETY_CHECK_PORT=8004
SEMANTIC_CACHE_PORT=8005
BANGLA_NORMALIZER_PORT=8006
FEEDBACK_PORT=8007
ANALYTICS_PORT=8008
OLLAMA_MGR_PORT=8009
LEADS_PORT=8011
HERBAL_CATALOG_PORT=8012
VISION_PORT=8013

# External & Local Services
CHROMADB_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Facebook Messenger Integration (used by the n8n webhook workflow & diagnostics)
